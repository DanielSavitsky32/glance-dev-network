def nth_sunday(y, m, n):
    """Day of the month of the nth Sunday, or the last one when n is -1."""
    if n == -1:
        last = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][m - 1]
        if m == 2 and y % 4 == 0 and (y % 100 != 0 or y % 400 == 0):
            last = 29
        return last - ((weekday(days_from_civil(y, m, last)) + 1) % 7)
    first = 1 + ((6 - weekday(days_from_civil(y, m, 1))) % 7)
    return first + 7 * (n - 1)

def last_dow(y, m, dow):
    """Day of the month of the last given weekday (0 = Monday)."""
    last = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][m - 1]
    if m == 2 and y % 4 == 0 and (y % 100 != 0 or y % 400 == 0):
        last = 29
    return last - ((weekday(days_from_civil(y, m, last)) - dow) % 7)

def _utcmin(y, m, d, hh):
    return days_from_civil(y, m, d) * 1440 + hh * 60

def zone_offset_at(zone, t):
    """Minutes east of UTC for `zone` at the UTC instant `t` (minutes since
    the epoch)."""
    z = TZ[zone] if zone in TZ else TZ["UTC"]
    std, rule = z[0], z[1]
    if rule == 0:
        return std
    y = civil_from_days(t // 1440)[0]
    if rule == 1:
        start = _utcmin(y, 3, nth_sunday(y, 3, 2), 2) - std
        end = _utcmin(y, 11, nth_sunday(y, 11, 1), 2) - std - 60
        return std + 60 if t >= start and t < end else std
    if rule == 2:
        start = _utcmin(y, 3, nth_sunday(y, 3, -1), 1)
        end = _utcmin(y, 10, nth_sunday(y, 10, -1), 1)
        return std + 60 if t >= start and t < end else std
    if rule == 5:
        start = _utcmin(y, 4, last_dow(y, 4, 4), 0) - std
        end = _utcmin(y, 10, last_dow(y, 10, 4), 0) - std - 60
        return std + 60 if t >= start and t < end else std
    if rule == 6:
        start = _utcmin(y, 3, nth_sunday(y, 3, -1) - 2, 2) - std
        end = _utcmin(y, 10, nth_sunday(y, 10, -1), 2) - std - 60
        return std + 60 if t >= start and t < end else std
    m0 = 10 if rule == 3 else 9
    n0 = 1 if rule == 3 else -1
    start = _utcmin(y, m0, nth_sunday(y, m0, n0), 2) - std
    end = _utcmin(y, 4, nth_sunday(y, 4, 1), 3) - std - 60
    return std if t >= end and t < start else std + 60

def local_date(ctx):
    """(year, month, day) in the viewer's chosen time zone."""
    zone = str(ctx.inputs.get("timezone", "UTC")).strip()
    off_min = zone_offset_at(zone, ctx.now.unix // 60)
    local_min = ctx.now.unix // 60 + off_min
    y, m, d = civil_from_days(local_min // 1440)
    return y, m, d

# ---- data ---------------------------------------------------------------

def fetch_events(month, day):
    url = "https://api.dayinhistory.dev/v1/events/" + MONTHS[month - 1].lower() + "/" + str(day) + "/"
    resp = http.get(url, ttl_seconds = 86400)
    if resp["status_code"] != 200 or resp["json"] == None:
        return []
    return resp["json"].get("results", [])

def date(c, ctx):
    c.fill("black")
    c.text_center("TODAY IN HISTORY", 2, font = "5x7", color = "green")

    y, m, d = local_date(ctx)
    c.text_center(MONTHS[m - 1] + " " + str(d), 13, font = "6x8", color = "white")

    events = fetch_events(m, d)
    if len(events) > 0:
        c.text_center(str(len(events)) + " EVENTS", 24, font = "5x7", color = "gray")
    else:
        c.text_center("NO DATA - RETRY", 24, font = "5x7", color = "red")

def event_page(c, ctx, index):
    c.fill("black")

    y, m, d = local_date(ctx)
    events = fetch_events(m, d)
    if len(events) == 0:
        c.text_center("NO DATA", 12, font = "6x8", color = "red")
        c.text_center("TRY AGAIN LATER", 21, font = "5x7", color = "gray")
        return

    if index >= len(events):
        c.text_center("THAT'S ALL", 12, font = "6x8", color = "gray")
        c.text_center("FOR TODAY", 21, font = "6x8", color = "gray")
        return

    e = events[index]
    pad = 8
    c.text(str(e["year"]), pad, 2, font = "6x8", color = "amber")
    c.text_wrapped(e["title"].upper(), pad, 11, c.width - pad * 2, font = "4x5", color = "green", max_lines = 3)

def event1(c, ctx):
    event_page(c, ctx, 0)

def event2(c, ctx):
    event_page(c, ctx, 1)

def event3(c, ctx):
    event_page(c, ctx, 2)

def event4(c, ctx):
    event_page(c, ctx, 3)

def event5(c, ctx):
    event_page(c, ctx, 4)

def event6(c, ctx):
    event_page(c, ctx, 5)
